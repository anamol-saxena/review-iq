# Copy this file to .env and fill in what you have.

# Required for Gemini AI analysis (Server-Side Proxy)
# Get your key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Required for Amazon reviews and SaarMind (Google Maps Reviews via Apify)
# Get your token at https://console.apify.com/ → Settings → Integrations → API token
APIFY_TOKEN=

# Optional — enables real Yelp Fusion API data (free tier) for restaurants.
# Get one at https://www.yelp.com/developers/v3/manage_app
YELP_API_KEY=

PORT=8787
